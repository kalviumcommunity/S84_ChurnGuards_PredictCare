# ChurnGuards PredictCare Environment Variables
# Copy this file to .env before starting the application.

# OpenAI API Key for generating insights, retention strategies, and ticket sentiment
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (Optional - defaults to churnguard.db)
# DB_PATH=churnguard.db

# Application Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
